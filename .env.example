# Copiez ce fichier en .env et remplissez vos clés (ne commitez jamais .env)

# Analyse / script (Groq, modèles OpenAI gpt-oss, palier gratuit) -> https://console.groq.com/keys
GROQ_API_KEY=votre_cle_groq

# Génération vidéo (Hugging Face Spaces, gratuit) -> https://huggingface.co/settings/tokens
# Créez un token de type "Read". Compte gratuit : 5 min de GPU ZeroGPU par jour.
HF_TOKEN=votre_token_huggingface

# Durée totale max (s) : au-delà de 8 s, la vidéo est faite de segments enchaînés (1 segment ≈ 1 min de quota GPU)
# HF_MAX_TOTAL=24

# Optionnel : modèle Groq avec vision pour remplir le prompt depuis les images/vidéos
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optionnel : Space utilisé pour la vidéo (doit exposer /text_to_video et /image_to_video)
# HF_SPACE=Lightricks/ltx-video-distilled
# HF_WIDTH=704
# HF_HEIGHT=512

# Son : si aucun fichier audio n'est chargé, le son est généré par le Space MMAudio (même token HF).
# HF_AUDIO=0 pour désactiver (vidéo sans son, économise le quota GPU)
# HF_AUDIO=1
# HF_AUDIO_SPACE=hkchengrex/MMAudio

# Optionnel : modèles Groq essayés dans l'ordre en cas de surcharge / limite de débit
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
